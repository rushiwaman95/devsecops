title SaaS Application AWS Infrastructure - Production Architecture

# AWS Cloud Boundary
AWS_Cloud {
  region "us-east-1" {
    
    # VPC Boundary
    vpc "VPC: 10.0.0.0/16" {
      
      # Availability Zone A
      az "Availability Zone: us-east-1a" {
        
        # Public Subnet A
        public_subnet_a["Public Subnet A\n10.0.1.0/24"]
        
        # Private Subnet A
        private_subnet_a["Private Subnet A\n10.0.10.0/24"]
      }
      
      # Availability Zone B
      az "Availability Zone: us-east-1b" {
        
        # Public Subnet B
        public_subnet_b["Public Subnet B\n10.0.2.0/24"]
        
        # Private Subnet B
        private_subnet_b["Private Subnet B\n10.0.11.0/24"]
      }
      
      # Internet Gateway
      igw["Internet Gateway"]
      
      # NAT Gateway (in Public Subnet A)
      nat_gw["NAT Gateway\n(Single for cost optimization)"]
      
      # Application Load Balancer (spans both AZs)
      alb["Application Load Balancer\n- HTTPS (443)\n- HTTP (80) -> Redirect to HTTPS\n- Health Checks: /health\n- TLS 1.3 Policy"]
      
      # Auto Scaling Group (in Private Subnets)
      asg["Auto Scaling Group\n- Min: 2 instances\n- Max: 4 instances\n- Instance Type: t3.medium\n- Encrypted EBS (gp3)\n- IAM Role (no static keys)\n- IMDSv2 Required"]
      
      # EC2 Instances (conceptual group)
      ec2_group["EC2 Instances\n- NGINX Web Server\n- Health endpoint: /health\n- CloudWatch Agent\n- In Private Subnets Only"]
      
      # S3 Bucket
      s3["S3 Bucket\n- Block Public Access: Enabled\n- Encryption: AES-256\n- Versioning: Enabled"]
      
      # CloudWatch Resources
      cw_logs["CloudWatch Logs\n- /aws/ec2/{app}/application\n- /aws/ec2/{app}/nginx-access\n- /aws/ec2/{app}/nginx-error"]
      
      cw_alarms["CloudWatch Alarms\n- High CPU (>70%)\n- Unhealthy Hosts (>0)\n- Low Request Count"]
      
      cw_dashboard["CloudWatch Dashboard\n- CPU Utilization\n- Request Count\n- Unhealthy Hosts\n- Network I/O"]
      
      # SNS Topic
      sns["SNS Topic\n- Alert notifications\n- Budget alerts"]
      
      # Budget
      budget["AWS Budget\n- Monthly limit: $500\n- Alerts at 80%, 100%\n- Forecasted alert at 50%"]
      
      # ACM Certificate (optional)
      acm["ACM Certificate\n- HTTPS on ALB\n- TLS 1.3"]
    }
    
    # Route Tables
    public_rt["Public Route Table\n0.0.0.0/0 -> IGW"]
    private_rt["Private Route Table\n0.0.0.0/0 -> NAT Gateway"]
    
    # Security Groups
    sg_alb["Security Group: ALB\nIngress:\n- 443 from 0.0.0.0/0\n- 80 from 0.0.0.0/0\nEgress: All"]
    
    sg_ec2["Security Group: EC2\nIngress:\n- 80 from ALB SG\n- 8080 from ALB SG\nEgress: All"]
  }
}

# External Users
users["Users/Browsers\nHTTPS Traffic"]

# Relationships
users -> alb : "HTTPS (443)"
alb --> public_subnet_a : "Route traffic"
alb --> public_subnet_b : "Route traffic"
public_subnet_a --> private_subnet_a : "Forward to targets"
public_subnet_b --> private_subnet_b : "Forward to targets"
private_subnet_a --> ec2_group : "Health checks & requests"
private_subnet_b --> ec2_group : "Health checks & requests"
ec2_group --> nat_gw : "Outbound internet (updates)"
nat_gw --> public_subnet_a : "Route through"
public_subnet_a --> igw : "Internet access"
igw --> users : "Response traffic"
ec2_group --> cw_logs : "Stream logs"
ec2_group --> s3 : "Store/retrieve objects"
cw_alarms --> sns : "Trigger alerts"
budget --> sns : "Budget notifications"
acm --> alb : "SSL/TLS termination"

# Styling
style alb fill:#f9f,stroke:#333,stroke-width:2px
style ec2_group fill:#bbf,stroke:#333,stroke-width:2px
style s3 fill:#bfb,stroke:#333,stroke-width:2px
style users fill:#ff9,stroke:#333,stroke-width:2px
